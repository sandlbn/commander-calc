# Build output. Matches at any depth, so docs/manual/build/ is covered too.
build/
*.o
*.map
*.lst
*.PRG
*.BIN

# Debugger and emulator leavings. Lowercase .bin only -- OVL*.BIN is caught
# by the rule above, and site/CHART.BMP is committed on purpose.
*.bin
*.gif
labels.txt

# Generated by `make xlsxdemo` as a reference export.
CMDRCALC-EXPORT.XLSX

__pycache__/
.venv/

# NOT ignored, on purpose:
#   docs/manual/pdf/   the published manual  (make pdf)
#   site/CHART.BMP     the sample chart on the project page
#   site/*.png         screenshots
