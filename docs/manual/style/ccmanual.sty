% ---------------------------------------------------------------------------
% ccmanual.sty -- house style for the Commander Calc Reference
%
% The model is a late-1980s / early-1990s software reference manual: a 7 x 9
% inch page, Times body, Helvetica headings, Courier for anything the machine
% says or the user types, chapter-relative page numbers, and a black thumb tab
% on the outer edge that steps down the page as the chapters go by.
%
% Everything drawn is drawn here or in cclogo.tex / ccscreen.tex. There is no
% \includegraphics anywhere in this manual and no external image file.
% ---------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/ccmanual}[2026/08/08 Commander Calc manual style]

% --- fonts -----------------------------------------------------------------
% Nimbus Roman / Nimbus Sans / Nimbus Mono: the Times / Helvetica / Courier
% trio the period manuals were set in.
\RequirePackage[T1]{fontenc}
\RequirePackage{textcomp}
\RequirePackage{mathptmx}
\RequirePackage[scaled=0.92]{helvet}
\RequirePackage{courier}
\RequirePackage{microtype}

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning,arrows.meta,shapes.geometric,fit,backgrounds}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{multirow}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{fancyvrb}
\RequirePackage{eso-pic}

% --- colours ---------------------------------------------------------------
% The screen mock-ups use the Commander X16's own 16-colour palette so that a
% picture in this manual matches the picture on the monitor. The body of the
% manual is black on white, as it would have been.
\definecolor{x16black}    {HTML}{000000}
\definecolor{x16white}    {HTML}{FFFFFF}
\definecolor{x16red}      {HTML}{813338}
\definecolor{x16cyan}     {HTML}{75CEC8}
\definecolor{x16purple}   {HTML}{8E3C97}
\definecolor{x16green}    {HTML}{56AC4D}
\definecolor{x16blue}     {HTML}{2E2C9B}
\definecolor{x16yellow}   {HTML}{EDF171}
\definecolor{x16orange}   {HTML}{8E5029}
\definecolor{x16brown}    {HTML}{553800}
\definecolor{x16lred}     {HTML}{C46C71}
\definecolor{x16dgrey}    {HTML}{4A4A4A}
\definecolor{x16mgrey}    {HTML}{7B7B7B}
\definecolor{x16lgreen}   {HTML}{A9FF9F}
\definecolor{x16lblue}    {HTML}{706DEB}
\definecolor{x16lgrey}    {HTML}{B2B2B2}

\definecolor{ccink}       {HTML}{111820}   % the logo's black
\definecolor{ccblue}      {HTML}{244F77}   % the logo's blue
\definecolor{ccrule}      {HTML}{000000}
\definecolor{ccpanel}     {HTML}{E8E8E8}   % note / caution panel fill
\definecolor{ccpanelrule} {HTML}{808080}

% --- page shape ------------------------------------------------------------
% 7 x 9 inches: a ring-bound software manual, not a book.
\setstocksize{9in}{7in}
\settrimmedsize{\stockheight}{\stockwidth}{*}
\settypeblocksize{7.05in}{5.05in}{*}
\setlrmargins{1.00in}{*}{*}
\setulmargins{0.85in}{*}{*}
\setheadfoot{14pt}{34pt}
\setheaderspaces{*}{20pt}{*}
\checkandfixthelayout

\setlength{\parindent}{0pt}
\setlength{\parskip}{7pt plus 2pt minus 1pt}
\linespread{1.045}
\raggedbottom
\midsloppy
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000

% --- chapter-relative page numbers ----------------------------------------
% Lotus numbered its pages 1-1, 1-2, ... 2-124. So does this. \pagenumbering
% takes the name of a numbering command, so defining one is all it costs, and
% \mainmatter can then switch to it the way it would switch to arabic.
% \pagenumbering{ccnum} expands \@ccnum and hands it the raw \c@page register,
% so the command it wants is \@ccnum, taking a count and not a counter name.
\newcommand{\@ccnum}[1]{\thechapter-\number#1}
\newif\ifccresetpage \ccresetpagefalse

% --- headings --------------------------------------------------------------
% Chapter opener: the number and title in heavy Helvetica over a thick rule.
\makechapterstyle{ccstyle}{%
  \renewcommand{\chapnamefont}{\normalfont\sffamily\bfseries\fontsize{11}{13}\selectfont}
  \renewcommand{\chapnumfont}{\normalfont\sffamily\bfseries\fontsize{11}{13}\selectfont}
  \renewcommand{\chaptitlefont}{\normalfont\sffamily\bfseries\fontsize{20}{23}\selectfont}
  \renewcommand{\printchaptername}{\chapnamefont\MakeUppercase{\@chapapp}}
  \renewcommand{\chapternamenum}{\space}
  \renewcommand{\printchapternum}{\chapnumfont\thechapter}
  \renewcommand{\afterchapternum}{\par\vskip 6pt\hrule height 2.5pt\vskip 12pt}
  \renewcommand{\printchapternonum}{\vskip 6pt\hrule height 2.5pt\vskip 12pt}
  \renewcommand{\afterchaptertitle}{\par\vskip 4pt\hrule height 0.6pt\par\vskip 26pt}
}
\chapterstyle{ccstyle}
\setlength{\beforechapskip}{0pt}
\setlength{\afterchapskip}{0pt}

% Each chapter restarts the folio at 1 and steps the thumb tab one notch down
% the outer edge. Both happen on the chapter's own first page, after the
% \cleardoublepage that opened it, so the page being built is the one that
% becomes page 1.
\renewcommand{\chapterheadstart}{%
  \vspace*{\beforechapskip}%
  \ifccresetpage
    \setcounter{page}{1}%
    \ccchapterhook
  \fi
}

\setsecheadstyle{\normalfont\sffamily\bfseries\fontsize{14}{16}\selectfont\raggedright}
\setbeforesecskip{-20pt plus -4pt minus -2pt}
\setaftersecskip{7pt plus 2pt}

\setsubsecheadstyle{\normalfont\sffamily\bfseries\fontsize{11}{13}\selectfont\raggedright}
\setbeforesubsecskip{-15pt plus -3pt minus -2pt}
\setaftersubsecskip{5pt plus 1pt}

\setsubsubsecheadstyle{\normalfont\sffamily\bfseries\fontsize{10}{12}\selectfont\raggedright}
\setbeforesubsubsecskip{-13pt plus -3pt minus -2pt}
\setaftersubsubsecskip{4pt plus 1pt}

% Chapters are numbered because the text refers to them constantly. Sections
% are not: a manual of this period sets its headings plain and lets the
% contents page and the index do the finding.
\setsecnumdepth{chapter}
\maxsecnumdepth{chapter}
\settocdepth{subsection}

% Contents page numbers are chapter-relative, so the widest is "14-10" in
% Helvetica bold -- about twice what memoir allows for a plain folio.
\setpnumwidth{2.9em}
\setrmarg{3.8em}

% --- running heads and feet ------------------------------------------------
% A hairline under the head; the folio and the part name at the foot, mirrored.
\newcommand{\ccparttitle}{Reference}
\newcommand{\setccpart}[1]{\renewcommand{\ccparttitle}{#1}}

\makepagestyle{ccpage}
\makeevenhead{ccpage}{}{}{}
\makeoddhead{ccpage}{}{}{}
\makeheadrule{ccpage}{\textwidth}{0.4pt}
\makeevenfoot{ccpage}{\normalfont\sffamily\fontsize{8.5}{10}\selectfont\thepage\hspace{1.2em}\ccparttitle}{}{}
\makeoddfoot{ccpage}{}{}{\normalfont\sffamily\fontsize{8.5}{10}\selectfont\ccparttitle\hspace{1.2em}\thepage}
\makepsmarks{ccpage}{%
  \createmark{chapter}{both}{shownumber}{}{\space\space}%
}
\makeevenhead{ccpage}{\normalfont\sffamily\fontsize{8.5}{10}\selectfont\leftmark}{}{}
\makeoddhead{ccpage}{}{}{\normalfont\sffamily\fontsize{8.5}{10}\selectfont\rightmark}

\copypagestyle{ccchap}{ccpage}
\makeevenhead{ccchap}{}{}{}
\makeoddhead{ccchap}{}{}{}
\makeheadrule{ccchap}{\textwidth}{0pt}
\aliaspagestyle{chapter}{ccchap}

% --- the thumb tab ---------------------------------------------------------
% A solid black bar bleeding off the outer edge, one step lower per chapter.
% Fan the closed manual and the chapter you want is the black mark that lines
% up with the one on the divider page.
\newif\ifccthumb \ccthumbtrue
\newcounter{ccthumbpos}
\setcounter{ccthumbpos}{0}
\newlength{\ccthumbtop}    \setlength{\ccthumbtop}{1.15in}
\newlength{\ccthumbstep}   \setlength{\ccthumbstep}{0.40in}
\newlength{\ccthumbh}      \setlength{\ccthumbh}{0.34in}
\newlength{\ccthumbw}      \setlength{\ccthumbw}{0.42in}

\newlength{\cc@thumby}
\newcommand{\ccthumbmark}{%
  \ifccthumb
    \setlength{\cc@thumby}{\ccthumbtop}%
    \addtolength{\cc@thumby}{-\ccthumbstep}%
    \addtolength{\cc@thumby}{\value{ccthumbpos}\ccthumbstep}%
    \begin{tikzpicture}[overlay,remember picture]
      \ifodd\value{page}
        \fill[ccink] ($(current page.north east)+(-\ccthumbw,-\cc@thumby)$)
          rectangle ++(\ccthumbw,-\ccthumbh);
      \else
        \fill[ccink] ($(current page.north west)+(0pt,-\cc@thumby)$)
          rectangle ++(\ccthumbw,-\ccthumbh);
      \fi
    \end{tikzpicture}%
  \fi
}
\AddToShipoutPictureBG{\ccthumbmark}

% Chapters cycle the tab down the page and back to the top after nine.
\newcommand{\ccchapterhook}{%
  \stepcounter{ccthumbpos}%
  \ifnum\value{ccthumbpos}>9\setcounter{ccthumbpos}{1}\fi
}

% --- inline notation -------------------------------------------------------
% A keycap. Drawn, not faked with brackets, because this manual talks about
% keys constantly and they must be scannable in a wall of text.
% Robust: a keycap is a tikzpicture, and an ordinary \newcommand expands
% into the .toc and .lof files as one, which they cannot be read back from.
\DeclareRobustCommand{\key}[1]{%
  \tikz[baseline=(kc.base)]{%
    \node[inner xsep=2.6pt,inner ysep=1.1pt,rounded corners=1.2pt,
          draw=ccink,line width=0.5pt,fill=black!4]
      (kc) {\sffamily\bfseries\fontsize{7.6}{8.6}\selectfont\MakeUppercase{#1}};}%
}
% Two keys pressed together.
\DeclareRobustCommand{\keyc}[2]{\key{#1}\,{\footnotesize+}\,\key{#2}}

\newcommand{\menupath}[1]{{\sffamily\bfseries #1}}
\newcommand{\cmdname}[1]{{\sffamily\bfseries #1}}
\newcommand{\cellref}[1]{{\ttfamily #1}}
\newcommand{\fml}[1]{{\ttfamily #1}}
\newcommand{\lit}[1]{{\ttfamily #1}}
\newcommand{\fname}[1]{{\ttfamily #1}}
\newcommand{\msg}[1]{{\ttfamily #1}}
\newcommand{\errv}[1]{{\ttfamily\bfseries #1}}
\newcommand{\fn}[1]{{\sffamily\bfseries #1}}

% --- note and caution panels ----------------------------------------------
% The two-tier aside of the period: NOTE for something useful, CAUTION for
% something that costs you a workbook.
\newenvironment{ccnote}{%
  \par\needspace{3\baselineskip}\vspace{4pt}%
  \begingroup
  \setlength{\leftskip}{14pt}%
  \noindent\llap{\raisebox{-1.2pt}{\rule{2.2pt}{\baselineskip}}\hspace{9pt}}%
  \sffamily\bfseries\fontsize{8.2}{10}\selectfont NOTE\hspace{0.9em}%
  \normalfont\fontsize{9.3}{11.6}\selectfont\ignorespaces
}{%
  \par\endgroup\vspace{5pt}%
}

\newenvironment{cccaution}{%
  \par\needspace{3\baselineskip}\vspace{6pt}%
  \begingroup
  \setlength{\fboxsep}{7pt}%
  \setlength{\leftskip}{0pt}%
  \begin{lrbox}{\cc@cautionbox}%
  \begin{minipage}{\dimexpr\linewidth-16pt\relax}%
  \sffamily\bfseries\fontsize{8.2}{10}\selectfont CAUTION\hspace{0.9em}%
  \normalfont\fontsize{9.3}{11.6}\selectfont\ignorespaces
}{%
  \end{minipage}%
  \end{lrbox}%
  \noindent\colorbox{ccpanel}{\usebox{\cc@cautionbox}}%
  \par\endgroup\vspace{7pt}%
}
\newsavebox{\cc@cautionbox}

% --- procedures ------------------------------------------------------------
% "Procedure" followed by numbered steps is the shape of every task in a
% manual of this vintage.
\newenvironment{ccprocedure}[1][Procedure]{%
  \par\needspace{4\baselineskip}\vspace{3pt}%
  {\sffamily\bfseries\fontsize{9.5}{11}\selectfont #1}\par\vspace{2pt}%
  \begin{enumerate}[topsep=0pt,itemsep=1.5pt,parsep=0pt,leftmargin=18pt,
                    labelsep=6pt,label=\arabic*.]%
}{%
  \end{enumerate}\vspace{2pt}%
}

\newenvironment{ccsteps}{%
  \begin{itemize}[topsep=0pt,itemsep=1.5pt,parsep=0pt,leftmargin=13pt,
                  labelsep=6pt,label=\textbullet]%
}{\end{itemize}}

% --- the two-column Command / Task table ----------------------------------
% No vertical rules, one rule above and one below, heads in Helvetica bold.
% \begin{cctable}{head A}{head B}{width A}{width B}
\newenvironment{cctable}[4]{%
  \par\needspace{4\baselineskip}\vspace{2pt}%
  \begingroup
  \fontsize{9.2}{11.4}\selectfont
  \setlength{\tabcolsep}{0pt}%
  \setlength{\LTpre}{2pt}\setlength{\LTpost}{2pt}%
  \renewcommand{\arraystretch}{1.18}%
  \begin{longtable}{@{}p{#3}@{\hspace{10pt}}p{#4}@{}}
  \sffamily\bfseries #1 & \sffamily\bfseries #2\\[1.5pt]
  \hline\\[-7pt]
  \endfirsthead
  \sffamily\bfseries #1 & \sffamily\bfseries #2\\[1.5pt]
  \hline\\[-7pt]
  \endhead
}{%
  \end{longtable}%
  \endgroup
  \vspace{3pt}%
}

% A plainer three-column variant used a lot in the reference part.
\newenvironment{cctablethree}[6]{%
  \par\needspace{4\baselineskip}\vspace{2pt}%
  \begingroup
  \fontsize{9.2}{11.4}\selectfont
  \setlength{\tabcolsep}{0pt}%
  \setlength{\LTpre}{2pt}\setlength{\LTpost}{2pt}%
  \renewcommand{\arraystretch}{1.18}%
  \begin{longtable}{@{}p{#4}@{\hspace{9pt}}p{#5}@{\hspace{9pt}}p{#6}@{}}
  \sffamily\bfseries #1 & \sffamily\bfseries #2 & \sffamily\bfseries #3\\[1.5pt]
  \hline\\[-7pt]
  \endfirsthead
  \sffamily\bfseries #1 & \sffamily\bfseries #2 & \sffamily\bfseries #3\\[1.5pt]
  \hline\\[-7pt]
  \endhead
}{%
  \end{longtable}%
  \endgroup
  \vspace{3pt}%
}

% Four columns, for the key tables.
\newenvironment{cctablefour}[8]{%
  \par\needspace{4\baselineskip}\vspace{2pt}%
  \begingroup
  \fontsize{9.2}{11.4}\selectfont
  \setlength{\tabcolsep}{0pt}%
  \setlength{\LTpre}{2pt}\setlength{\LTpost}{2pt}%
  \renewcommand{\arraystretch}{1.18}%
  \begin{longtable}{@{}p{#5}@{\hspace{8pt}}p{#6}@{\hspace{8pt}}p{#7}@{\hspace{8pt}}p{#8}@{}}
  \sffamily\bfseries #1 & \sffamily\bfseries #2 & \sffamily\bfseries #3 &
  \sffamily\bfseries #4\\[1.5pt]
  \hline\\[-7pt]
  \endfirsthead
  \sffamily\bfseries #1 & \sffamily\bfseries #2 & \sffamily\bfseries #3 &
  \sffamily\bfseries #4\\[1.5pt]
  \hline\\[-7pt]
  \endhead
}{%
  \end{longtable}%
  \endgroup
  \vspace{3pt}%
}

% --- reference entries -----------------------------------------------------
% One command. The heading is the menu path as the user reads it off the bar.
\newcommand{\cccmd}[2][]{%
  \needspace{5\baselineskip}%
  \subsection[#2]{#2}%
  \ifx\relax#1\relax\else
    \nopagebreak{\fontsize{9}{11}\selectfont\sffamily #1}\par\nopagebreak\vspace{2pt}%
  \fi
}

% One function. Heading, then the call shape in Courier under a hairline.
\newcommand{\ccfunc}[2]{%
  \needspace{6\baselineskip}%
  \subsection[#1]{#1}%
  \nopagebreak
  \vspace{-3pt}%
  {\ttfamily\fontsize{10}{12}\selectfont #2}\par
  \nopagebreak\vspace{2pt}\hrule height 0.4pt\vspace{6pt}%
}

% The small run-in headings inside a reference entry.
\newcommand{\ccrunin}[1]{\par\vspace{3pt}{\sffamily\bfseries\fontsize{9.5}{11}\selectfont #1}\par\vspace{1pt}}

% --- worked examples -------------------------------------------------------
% Formula on the left, what the cell then shows on the right.
\newenvironment{ccexamples}[2][Examples]{%
  \par\needspace{4\baselineskip}\vspace{3pt}%
  \ccrunin{#1}%
  \begingroup
  \fontsize{9.2}{12}\selectfont
  \setlength{\tabcolsep}{0pt}%
  \renewcommand{\arraystretch}{1.15}%
  \begin{tabular}{@{}p{0.44\linewidth}@{\hspace{8pt}}p{#2}@{}}
}{%
  \end{tabular}%
  \endgroup\par\vspace{4pt}%
}
\newcommand{\ex}[2]{{\ttfamily #1} & {\ttfamily #2}\\}
\newcommand{\exn}[3]{{\ttfamily #1} & {\ttfamily #2}\ \ {\normalfont\itshape #3}\\}

% --- figures ---------------------------------------------------------------
% "Figure 3-2  The Commander Calc screen" -- number and caption, no colon,
% caption set in Helvetica beneath the artwork.
% Figures are numbered 3-1, not 3.1, to match the page numbers. \counterwithin
% installs its own \thefigure, and memoir installs one again at \begin{document},
% so ours has to be the last word.
\counterwithin{figure}{chapter}
\AtBeginDocument{\renewcommand{\thefigure}{\thechapter-\arabic{figure}}}
\captiondelim{\hspace{1.1em}}
\captionnamefont{\sffamily\fontsize{8.6}{10.5}\selectfont}
\captiontitlefont{\sffamily\fontsize{8.6}{10.5}\selectfont}
\captionstyle{\raggedright}
\setlength{\abovecaptionskip}{7pt}
\setlength{\belowcaptionskip}{0pt}

\counterwithin{table}{chapter}
\AtBeginDocument{\renewcommand{\thetable}{\thechapter-\arabic{table}}}

\newenvironment{ccfigure}[1][htbp]{%
  \begin{figure}[#1]\centering
}{%
  \end{figure}
}

% --- part divider pages ----------------------------------------------------
\newcommand{\ccpartpage}[3]{%
  \cleardoublepage
  \thispagestyle{empty}%
  \ccthumbfalse
  \begin{center}
    \vspace*{1.6in}
    {\sffamily\bfseries\fontsize{13}{15}\selectfont\MakeUppercase{#1}}\par
    \vspace{10pt}
    \rule{3.4in}{2.5pt}\par
    \vspace{16pt}
    {\sffamily\bfseries\fontsize{26}{30}\selectfont #2}\par
    \vspace{22pt}
    \begin{minipage}{3.6in}\centering
      \setlength{\parindent}{0pt}\fontsize{10}{13.5}\selectfont #3
    \end{minipage}
    \vspace{0.9in}\par
    \ccmark[0.46in]
  \end{center}
  \cleardoublepage
  \ccthumbtrue
}

